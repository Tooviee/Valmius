{
  "name": "drillday",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "db:migrate": "dotenv -e .env.local -- supabase db push",
    "db:types": "dotenv -e .env.local -- supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "screenshots": "tsx --env-file=.env.local scripts/screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@base-ui/react": "^1.9.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "docx": "^9.12.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
