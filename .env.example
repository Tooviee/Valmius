# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Dashboard > Project Settings > API Keys) ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (starts with sb_publishable_). Safe in the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (starts with sb_secret_). SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Anthropic (console.anthropic.com > API Keys). Server only. ---
ANTHROPIC_API_KEY=
# Model used for scenario, plan and report generation
ANTHROPIC_MODEL=claude-sonnet-5-5
# Which implementation src/lib/llm uses: "anthropic" (real API) or "mock" (fixtures in tests/fixtures/llm).
# Vitest and Playwright force "mock" in their own configs, whatever this is set to.
LLM_PROVIDER=anthropic

# --- App ---
# Basic-auth password for /admin/leads in Phase 1 (replaced by real auth in Phase 2)
ADMIN_PASSWORD=
# Random 32+ char string used to hash visitor IPs before storing them in events/rate_limits
IP_HASH_SALT=
# Public site URL, used for links in PDFs and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase CLI (only needed for `supabase link` / `supabase db push`) ---
# Project ref is the subdomain of your Project URL (abcdefghijklmnop in the example above)
SUPABASE_PROJECT_REF=
# Database password you set when creating the project
SUPABASE_DB_PASSWORD=
